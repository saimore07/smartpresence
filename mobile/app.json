{
  "expo": {
    "name": "SmartPresence",
    "slug": "smartpresence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "smartpresence",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartpresence.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1a73e8"
      },
      "package": "com.smartpresence.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SmartPresence needs camera access to capture student photos and classroom images for attendance."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1a73e8"
        }
      ],
      "expo-sharing"
    ]
  }
}
