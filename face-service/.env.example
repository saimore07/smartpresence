# Environment Configuration for SmartPresence Face Service
SERVICE_NAME="SmartPresence Face Recognition Service"
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Shared internal communication secret between Node.js and FastAPI
INTERNAL_API_SECRET=smartpresence_internal_secret_2026

# Recognition Thresholds
ACCEPTANCE_THRESHOLD=0.52
REJECTION_THRESHOLD=0.36
DETECTION_SCORE_THRESHOLD=0.65
DETECTION_NMS_THRESHOLD=0.3
MIN_FACE_SIZE_PX=24

MAX_IMAGE_SIZE_MB=15
MAX_PHOTOS_PER_SESSION=8
